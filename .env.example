# Copy to .env before running `docker compose up`:
#   cp .env.example .env
#
# The values below will work out of the box for local testing on your own
# machine. Before deploying anywhere reachable over a network, replace
# POSTGRES_PASSWORD / JWT_ACCESS_SECRET / JWT_REFRESH_SECRET with real
# random values — generate each with:
#   openssl rand -base64 48

POSTGRES_PASSWORD=local_dev_db_password_change_me
JWT_ACCESS_SECRET=local_dev_access_secret_change_me
JWT_REFRESH_SECRET=local_dev_refresh_secret_change_me

# Public URLs as reached from the browser / API clients. Update these once
# you have a domain and TLS in front of the containers (see README).
PUBLIC_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:4000

# The one-time seed script (see README: "Run the seeder") creates the first
# admin account using these values. Change the password before running the
# seeder if you don't want this exact default.
SEED_ADMIN_EMAIL=admin@aptitude.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Admin
